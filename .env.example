# Copy to .env.local and fill in. Server-side only — never prefix these with NEXT_PUBLIC_.

# Dashboard login (single clinic admin)
CLINIC_ADMIN_EMAIL=
CLINIC_ADMIN_PASSWORD=
# Random string, at least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=

# Shared secret sent to the n8n webhooks
N8N_WEBHOOK_TOKEN=
